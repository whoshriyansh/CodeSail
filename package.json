{
  "name": "codesail",
  "displayName": "CodeSail",
  "publisher": "ws-codesail",
  "description": "Simplified Traycer AI: A planning layer for coding agents—analyze code, generate step-by-step plans, and suggest fixes with Groq AI.",
  "version": "0.0.1",
  "icon": "./src/icons/codesail_app.png",
  "keywords": [
    "AI",
    "coding agent",
    "planning layer",
    "code analysis",
    "reverse engineering",
    "Traycer"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/whoshriyansh/CodeSail"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:codesailView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codesailSidebar",
          "title": "CodeSail",
          "icon": "./src/icons/codesail_app.png"
        }
      ]
    },
    "views": {
      "codesailSidebar": [
        {
          "id": "codesailView",
          "name": "CodeSail View",
          "type": "webview",
          "icon": "./src/icons/codesail_app.png"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run bundle:extension && npm run build-webview",
    "bundle:extension": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=es2020 --sourcemap",
    "compile": "tsc -p ./",
    "watch": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=es2020 --watch",
    "build-webview": "cd webview-ui && npm run build",
    "pretest": "npm run build && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "dev": "npm run build-webview && npm run compile"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "groq-sdk": "^0.7.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.7.4",
    "@types/vscode": "^1.93.0",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.10",
    "eslint": "^9.13.0",
    "typescript": "^5.6.3"
  }
}
